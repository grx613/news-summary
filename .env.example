# Пример настроек. Настоящие значения живут в .env (он в .gitignore) или в переменных окружения.
# Реальные переменные окружения перекрывают .env, поэтому в systemd можно задавать их юнитом.

# --- обязательное ---
BOTHUB_API_KEY=
BOTHUB_BASE_URL=https://openai.bothub.chat/v1
MODEL=claude-haiku-5.5

# --- сервер ---
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
SITE_URL=https://news.147-45-251-157.nip.io

# --- кеш и сбор новостей ---
CACHE_TTL_HOURS=26
NEWS_WINDOW_HOURS=72
MAX_NEWS=30
MIN_NEWS=3
REDDIT_MIN_GAP_MS=3000
REFRESH_COOLDOWN_MIN=15

# --- лимиты ---
MAX_GENERATIONS_PER_HOUR=40
MAX_GENERATIONS_PER_IP_HOUR=10
MAX_SEARCHES_PER_IP_MIN=60
MAX_FORUM_POSTS_PER_IP_HOUR=12

# --- необязательное ---
# user:password — включить пароль на весь сайт и API (по умолчанию сайт открыт)
BASIC_AUTH=

# --- ежедневный обход ---
CRAWLER_ENABLED=1
CRAWLER_INTERVAL_HOURS=24
CRAWLER_CONCURRENCY=2
CRAWLER_GAP_MS=1500
US_UNIVERSE_LIMIT=130
CRYPTO_UNIVERSE_LIMIT=50

# --- дивиденды ---
# отдельный обход dohod.ru и stockanalysis.com: справочные данные без модели, свой файл
DIVIDENDS_ENABLED=1
DIVIDENDS_INTERVAL_HOURS=24

# --- индексы ---
# значения меняются весь торговый день, поэтому свой короткий интервал;
# история и состав подтягиваются отдельно, раз в сутки
INDICES_ENABLED=1
INDICES_QUOTE_MIN=5

# --- графики цен ---
# год дневных закрытий по каждому тикеру: справочные данные без модели, свой файл
CHARTS_ENABLED=1
CHARTS_INTERVAL_HOURS=24

# --- учёт расхода ---
# расход берётся из отчёта BotHub (/transaction/usage-report), а не из счётчика в памяти:
# переживает перезапуск и не теряется при перезаписи сводки. Ключ опознаётся по значению
# через /dev/key/list, поэтому в итог попадает только расход этого проекта
SPEND_ENABLED=1
SPEND_INTERVAL_HOURS=6
SPEND_FROM=2026-11-01

# --- вопросы к аналитику ---
# sonar-pro — поиск в интернете; off — отвечать только по кешу новостей
QA_SEARCH_MODEL=sonar-pro
QA_SEARCH_RECENCY=month
QA_FALLBACK_TO_CACHE=1

# --- обсуждения по тикерам ---
FORUM_ENABLED=1
# без него POST /forum/hide отвечает 403; задайте случайную строку
FORUM_MODERATOR_TOKEN=
